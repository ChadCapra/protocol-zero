default:
    @just --list

setup:
    @echo "🚀 Initializing Backend Sovereignty..."
    mix deps.get
    mix escript.install hex protobuf --force
    @echo "✅ Dependencies installed. Run: just proto"

proto:
    @echo "🔮 Generating Elixir Protobufs..."
    mkdir -p lib/proto
    export PATH="$HOME/.mix/escripts:$PATH"; \
    protoc --elixir_out=./lib/proto -I ./priv/proto base.proto
    @echo "✅ Protobufs generated."

server:
    mix run --no-halt

dev:
    iex -S mix

db:
    @echo "💾 Starting Sovereign DB (PostgreSQL)..."
    @mkdir -p priv/data
    @if [ ! -d "$PGDATA" ]; then initdb -D "$PGDATA" --auth=trust --no-locale --encoding=UTF8; fi
    pg_ctl -D "$PGDATA" -l priv/data/logfile start
    @echo "Postgres running. To stop: pg_ctl -D priv/data/pg stop"

clean:
    rm -rf _build deps lib/proto
